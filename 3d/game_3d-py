import pygame
import sys
import math

# ==================================================
# CONFIGURACION
# ==================================================
WIDTH, HEIGHT = 900, 600
FPS = 60
COLOR_FONDO = (12, 14, 22)
COLOR_TEXTO = (200, 200, 200)
COLOR_SUELO = (40, 45, 60)


# ==================================================
# VECTOR 3D
# ==================================================
class Vector3:
    def __init__(self, x=0.0, y=0.0, z=0.0):
        self.x = float(x)
        self.y = float(y)
        self.z = float(z)

    def __add__(self, o):
        return Vector3(self.x + o.x, self.y + o.y, self.z + o.z)

    def __sub__(self, o):
        return Vector3(self.x - o.x, self.y - o.y, self.z - o.z)

    def __mul__(self, s):
        return Vector3(self.x * s, self.y * s, self.z * s)

    def magnitud(self):
        return math.sqrt(self.x**2 + self.y**2 + self.z**2)

    def normalizar(self):
        m = self.magnitud()
        if m < 1e-9:
            return Vector3()
        return Vector3(self.x / m, self.y / m, self.z / m)


# ==================================================
# ROTACIONES 3D (matrices)
# ==================================================
def rotar_x(v, a):
    c, s = math.cos(a), math.sin(a)
    return Vector3(v.x, v.y * c - v.z * s, v.y * s + v.z * c)

def rotar_y(v, a):
    c, s = math.cos(a), math.sin(a)
    return Vector3(v.x * c + v.z * s, v.y, -v.x * s + v.z * c)

def rotar_z(v, a):
    c, s = math.cos(a), math.sin(a)
    return Vector3(v.x * c - v.y * s, v.x * s + v.y * c, v.z)


# ==================================================
# PROYECCION EN PERSPECTIVA
# ==================================================
def proyectar(v, cam_yaw, cam_pitch, cam_pos,
              fov=500.0, near=0.1):
    # 1) Trasladar al sistema de la camara.
    rel = v - cam_pos
    # 2) Rotar por -yaw alrededor de Y.
    rel = rotar_y(rel, -cam_yaw)
    # 3) Rotar por -pitch alrededor de X.
    rel = rotar_x(rel, -cam_pitch)
    # 4) Si esta detras de la camara, no se dibuja.
    if rel.z <= near:
        return None
    # 5) Proyeccion en perspectiva.
    factor = fov / rel.z
    x_pantalla = WIDTH // 2 + int(rel.x * factor)
    y_pantalla = HEIGHT // 2 - int(rel.y * factor)
    return (x_pantalla, y_pantalla)


# ==================================================
# CUBO
# ==================================================
VERTICES_CUBO = [
    Vector3(-1, -1, -1), Vector3( 1, -1, -1),
    Vector3( 1,  1, -1), Vector3(-1,  1, -1),
    Vector3(-1, -1,  1), Vector3( 1, -1,  1),
    Vector3( 1,  1,  1), Vector3(-1,  1,  1),
]
ARISTAS = [
    (0,1),(1,2),(2,3),(3,0),
    (4,5),(5,6),(6,7),(7,4),
    (0,4),(1,5),(2,6),(3,7),
]


class Cubo:
    def __init__(self, posicion, tamano=1.0, color=(100, 220, 255),
                 velocidad_giro=1.0, fase=0.0):
        self.posicion = posicion
        self.tamano = tamano
        self.color = color
        self.velocidad_giro = velocidad_giro
        self.fase = fase

    def vertices_mundo(self, tiempo):
        # Rotamos el cubo segun el tiempo y lo trasladamos a su posicion.
        a = tiempo * self.velocidad_giro + self.fase
        resultado = []
        for v in VERTICES_CUBO:
            r = rotar_x(v, a * 0.7)
            r = rotar_y(r, a * 1.1)
            r = rotar_z(r, a * 0.4)
            r = r * self.tamano
            resultado.append(r + self.posicion)
        return resultado


# ==================================================
# SUELO (una rejilla de lineas)
# ==================================================
def lineas_suelo(lado=10, paso=1):
    # Rejilla cuadrada sobre el plano Y = -2.
    lineas = []
    y = -2.0
    for i in range(-lado, lado + 1, paso):
        lineas.append((Vector3(i, y, -lado), Vector3(i, y, lado)))
        lineas.append((Vector3(-lado, y, i), Vector3(lado, y, i)))
    return lineas


# ==================================================
# JUEGO
# ==================================================
def main():
    pygame.init()
    pantalla = pygame.display.set_mode((WIDTH, HEIGHT))
    pygame.display.set_caption("Mini juego 3D - Pygame")
    reloj = pygame.time.Clock()
    fuente = pygame.font.SysFont("Arial", 15)

    # Camara
    cam_pos = Vector3(0, 0, -6)
    cam_yaw = 0.0
    cam_pitch = 0.0

    # Mundo
    cubos = [
        Cubo(Vector3(-3, 0, 0), 1.0, (100, 220, 255), 1.0, 0.0),
        Cubo(Vector3( 0, 0, 0), 1.2, (255, 180, 100), 0.7, 1.5),
        Cubo(Vector3( 3, 0, 0), 0.8, (200, 100, 255), 1.4, 3.0),
        Cubo(Vector3( 0, 2, 2), 0.6, (100, 255, 180), 1.8, 0.5),
        Cubo(Vector3(-2, 1, 3), 0.7, (255, 100, 140), 0.9, 2.2),
    ]
    suelo = lineas_suelo(lado=10)

    tiempo = 0.0

    while True:
        dt = reloj.tick(FPS) / 1000.0
        tiempo += dt

        # --- Eventos ---
        for e in pygame.event.get():
            if e.type == pygame.QUIT:
                pygame.quit(); sys.exit()
            if e.type == pygame.KEYDOWN and e.key == pygame.K_ESCAPE:
                pygame.quit(); sys.exit()

        # --- Movimiento de la camara ---
        teclas = pygame.key.get_pressed()
        vel = 4.0 * dt

        # Direccion "adelante" segun yaw.
        adelante = Vector3(math.sin(cam_yaw), 0,
                           math.cos(cam_yaw))
        derecha = Vector3(math.cos(cam_yaw), 0,
                          -math.sin(cam_yaw))

        if teclas[pygame.K_w]:
            cam_pos = cam_pos + adelante * vel
        if teclas[pygame.K_s]:
            cam_pos = cam_pos - adelante * vel
        if teclas[pygame.K_a]:
            cam_pos = cam_pos - derecha * vel
        if teclas[pygame.K_d]:
            cam_pos = cam_pos + derecha * vel

        # --- Rotacion de la camara con flechas ---
        if teclas[pygame.K_LEFT]:
            cam_yaw -= 1.5 * dt
        if teclas[pygame.K_RIGHT]:
            cam_yaw += 1.5 * dt
        if teclas[pygame.K_UP]:
            cam_pitch += 1.2 * dt
        if teclas[pygame.K_DOWN]:
            cam_pitch -= 1.2 * dt

        # Limitar el pitch para no dar vueltas raras.
        cam_pitch = max(-1.2, min(1.2, cam_pitch))

        # --- Dibujar ---
        pantalla.fill(COLOR_FONDO)

        # Suelo
        for a, b in suelo:
            pa = proyectar(a, cam_yaw, cam_pitch, cam_pos)
            pb = proyectar(b, cam_yaw, cam_pitch, cam_pos)
            if pa and pb:
                pygame.draw.line(pantalla, COLOR_SUELO, pa, pb, 1)

        # Cubos: ordenamos por distancia (lejos primero).
        cubos_ordenados = sorted(
            cubos,
            key=lambda c: (c.posicion - cam_pos).magnitud(),
            reverse=True)

        for cubo in cubos_ordenados:
            vertices = cubo.vertices_mundo(tiempo)
            puntos_2d = [
                proyectar(v, cam_yaw, cam_pitch, cam_pos)
                for v in vertices
            ]
            # Solo dibujamos las aristas cuyos dos extremos son visibles.
            for i, j in ARISTAS:
                if puntos_2d[i] and puntos_2d[j]:
                    pygame.draw.line(pantalla, cubo.color,
                                     puntos_2d[i], puntos_2d[j], 2)
            # Vertices
            for p in puntos_2d:
                if p:
                    pygame.draw.circle(pantalla, (255, 255, 255), p, 3)

        # --- HUD ---
        textos = [
            "Mini juego 3D - Pygame",
            "WASD: mover   Flechas: girar camara",
            "ESC: salir",
            f"Camara: ({cam_pos.x:.1f}, {cam_pos.y:.1f}, {cam_pos.z:.1f})",
        ]
        y = 15
        for t in textos:
            sup = fuente.render(t, True, COLOR_TEXTO)
            pantalla.blit(sup, (15, y))
            y += 22

        pygame.display.flip()


if __name__ == "__main__":
    main()